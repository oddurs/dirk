#!/usr/bin/env bash
#
# news — print the NEWS entry for one release, as Markdown.
#
#   scripts/news 0.4.0        the section for that version
#   scripts/news              the section for the version in Cargo.toml
#
# NEWS is the changelog; release notes are cut from it rather than written
# twice. It is GNU-form plain text — `*` for a release, `**` for a heading
# under it — and GitHub reads Markdown, so the headings are translated on the
# way out. Exits non-zero when there is no section for the version, which is
# what makes it usable as a check before a tag.
#
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
version=${1:-$(sed -n 's/^version = "\(.*\)"/\1/p' "$root/Cargo.toml" | head -1)}

[ -n "$version" ] || { echo "news: no version given and none in Cargo.toml" >&2; exit 2; }

body=$(awk -v v="$version" '
    $0 ~ "^\\* Noteworthy changes in release " v "( |$|\\()" { inside = 1; next }
    inside && /^\* Noteworthy changes in release / { exit }
    inside && /^-{20,}$/ { exit }
    inside { print }
' "$root/NEWS")

# Trim the blank lines top and bottom, then promote the GNU headings: `**` is
# a sub-heading in NEWS and nothing at all in Markdown.
body=$(printf '%s\n' "$body" \
    | sed -e '/./,$!d' -e 's/^\*\* /### /' \
    | awk '{ l[NR] = $0 } END { n = NR; while (n > 0 && l[n] ~ /^[ \t]*$/) n--; for (i = 1; i <= n; i++) print l[i] }')

[ -n "$body" ] || { echo "news: NEWS has no section for $version" >&2; exit 1; }

printf '%s\n' "$body"

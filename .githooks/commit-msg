#!/usr/bin/env sh
#
# commit-msg — keep tool attribution out of the history.
#
# This project's history should say who decided something, not which program
# typed it. Coding-agent harnesses add a `Co-authored-by` trailer and a
# generated-with footer by default, and once either is in a published history
# it cannot be removed without rewriting it, so the check belongs here rather
# than in the settings file of whichever harness happens to be running.
#
# Human co-authors are left alone. Only trailers naming a tool are dropped.
#
set -eu

msg=$1
tmp=$msg.attribution

sed \
    -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*[Cc]laude/d' \
    -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*[Aa]nthropic/d' \
    -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*noreply@anthropic\.com/d' \
    -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*\[bot\]/d' \
    -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*[Cc]opilot/d' \
    -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*[Cc]ursor/d' \
    -e '/[Gg]enerated with \[*[Cc]laude/d' \
    -e '/^.*🤖 [Gg]enerated with/d' \
    -e '/^[Aa]ssisted-[Bb]y:/d' \
    "$msg" > "$tmp"

# Whatever was removed leaves blank lines behind; a message ending in three of
# them is its own kind of tell.
awk '{ l[NR] = $0 } END { n = NR; while (n > 0 && l[n] ~ /^[ \t]*$/) n--; for (i = 1; i <= n; i++) print l[i] }' \
    "$tmp" > "$msg"

rm -f "$tmp"

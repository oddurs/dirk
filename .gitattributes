# Line endings are normalised on the way in and checked out as LF everywhere.
# dirk writes escape sequences to a terminal; a CRLF that survives into a test
# fixture is a bug that only reproduces on one platform.
* text=auto eol=lf

# Hunk headers that name the function rather than the nearest brace.
*.rs   text diff=rust
*.md   text diff=markdown
*.toml text
*.1    text

# Generated, and reviewed as a fact rather than as prose.
Cargo.lock  text -diff linguist-generated=true
ROADMAP.md  text linguist-generated=true

# The backlog is documentation, not source; it should not colour the language
# bar or count as the project having been written in Markdown.
cairn/items/*.md text linguist-documentation

# The licence is 35k of text nobody diffs.
COPYING text -diff linguist-vendored=true

*.png binary
*.gif binary
*.cast binary

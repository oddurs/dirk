/target

# Generated at distribution time from the history; the history is the changelog
# here, and keeping a second copy under version control means keeping two.
/ChangeLog
/dirk-*.tar.gz
/dirk-*/
/dist

# The built site. It is generated from the repository on every deploy; a copy
# under version control would be a second answer to the same question.
/site/dist

# Editors and platforms leave things behind; none of it belongs in the history.
*.swp
.DS_Store
